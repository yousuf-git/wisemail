{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "server-only": ["./src/stubs/server-only.ts"],
      "next/navigation": ["./src/stubs/next-navigation.ts"],
      "next/headers": ["./src/stubs/next-headers.ts"],
      "next/server": ["./src/stubs/next-server.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "app/**/*.ts",
    "inngest/**/*.ts",
    "emails/**/*.ts",
    "emails/**/*.tsx"
  ],
  "exclude": ["src/**/*.test.ts", "lib/**/*.test.ts", "tests/**", "scripts/**", "node_modules"]
}
