{
  "name": "@wisemail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "db:dev": "bash scripts/dev-mongo.sh",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "mail:check": "tsx scripts/mail-check.ts",
    "webhook:test": "tsx scripts/send-test-webhook.ts",
    "stripe:simulate": "tsx scripts/stripe-simulate.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@better-auth/stripe": "^1.7.6",
    "@fastify/cookie": "^11.0.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/node": "^10.22.0",
    "@wisemail/shared": "workspace:*",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "fastify": "^5.6.1",
    "inngest": "^4.21.0",
    "isomorphic-dompurify": "^4.4.0",
    "mailparser": "^3.9.31",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.2",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "stripe": "^22.6.2",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
