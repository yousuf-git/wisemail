# =============================================================================
# Wisemail SPA (frontend / Vite) — @wisemail/spa
# =============================================================================
# Copy to apps/spa/.env.local for local overrides, or set the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Only VITE_* (and legacy SENTRY_DSN) are exposed to the browser bundle.
# Server secrets never belong here — use the repo-root `.env.example` → `.env.local`
# for the Fastify API.
#
# Types: apps/spa/src/vite-env.d.ts
# Docs: docs/deploy/VERCEL.md

# --- API origin ---
# Local: leave empty so Vite proxies /api → http://127.0.0.1:4000 (same-origin cookies).
# Production (Vercel): public Fastify origin, no trailing slash.
#   VITE_API_URL=https://api.example.com
VITE_API_URL=

# Dev-only: override the Vite proxy target (default http://127.0.0.1:4000).
# VITE_API_PROXY=http://127.0.0.1:4000

# --- Observability (optional) ---
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=

# Match with API when split-deploying:
#   API APP_URL          = this SPA origin (e.g. https://app.example.com)
#   API BETTER_AUTH_URL  = VITE_API_URL
#   API COOKIE_DOMAIN    = .example.com  (if app. + api. share a parent)
