# SPA (Vite) — copy to apps/spa/.env.local for local overrides, or set in Vercel → Environment Variables.
# Only VITE_* are exposed to the browser bundle.

# Public Fastify origin (OCI). Leave empty in local dev to use the Vite `/api` proxy.
# Production example: https://api.example.com
VITE_API_URL=

# Optional client Sentry (needs @sentry/browser installed in this package)
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=
