{
  "name": "wisemail",
  "version": "0.1.0",
  "private": true,
  "author": "M. Yousuf <hi@yousuf.app> (https://yousuf.app)",
  "homepage": "https://yousuf.app",
  "_developer": {
    "name": "M. Yousuf",
    "github": "https://github.com/yousuf-git",
    "portfolio": "https://yousuf.app"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wisemail/web --filter @wisemail/api run dev",
    "dev:web": "pnpm --filter @wisemail/web dev",
    "dev:spa": "pnpm --filter @wisemail/spa dev",
    "dev:api": "pnpm --filter @wisemail/api dev",
    "build": "pnpm -r --filter @wisemail/shared --filter @wisemail/api --filter @wisemail/spa run build",
    "build:next": "pnpm --filter @wisemail/web run build",
    "clean:next": "bash scripts/clean-next.sh",
    "start": "pnpm --filter @wisemail/api start",
    "start:next": "pnpm --parallel --filter @wisemail/web --filter @wisemail/api run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @wisemail/web test && pnpm --filter @wisemail/api test && pnpm --filter @wisemail/shared test",
    "test:watch": "pnpm --filter @wisemail/web test:watch",
    "test:e2e": "pnpm --filter @wisemail/web test:e2e",
    "test:e2e:spa": "pnpm --filter @wisemail/spa test:e2e",
    "format": "prettier --write .",
    "db:dev": "pnpm --filter @wisemail/web db:dev",
    "db:seed": "pnpm --filter @wisemail/web db:seed",
    "admin:create": "pnpm --filter @wisemail/web admin:create",
    "mail:check": "pnpm --filter @wisemail/web mail:check",
    "webhook:test": "pnpm --filter @wisemail/web webhook:test",
    "stripe:simulate": "pnpm --filter @wisemail/web stripe:simulate",
    "perf": "pnpm --filter @wisemail/web perf"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  }
}
