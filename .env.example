# Wisemail environment. Copy to .env.local for development.
# Validated by lib/env.ts (scripts/check-env.ts on prebuild, instrumentation.ts on server start).
# In development/test only the "Core" block is required; services default to fake mode.
# In production every live-mode variable is required.

# --- Core (always required) ---
MONGODB_URI=mongodb://127.0.0.1:27017/wisemail?replicaSet=rs0
BETTER_AUTH_SECRET=            # >= 32 chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000  # public base URL, used when registering webhooks; https in production
ENCRYPTION_KEK_CURRENT=        # base64-encoded 32 bytes, e.g. `openssl rand -base64 32`
ENCRYPTION_KEK_ID=kek-1
ENCRYPTION_KEK_PREVIOUS=       # optional, set during KEK rotation (records wrapped by it stay readable)
ENCRYPTION_KEK_PREVIOUS_ID=    # required with ENCRYPTION_KEK_PREVIOUS: the kek id those records carry

# --- Service modes (default: fake in dev/test, live in production) ---
RESEND_MODE=fake               # live | fake
STORAGE_MODE=fake              # r2 | fake
AI_MODE=fake                   # live | fake
INNGEST_DEV=true               # true = local Inngest dev server, no keys needed

# --- Inngest (required when INNGEST_DEV=false) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cloudflare R2 (required when STORAGE_MODE=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- AI, any OpenAI-compatible endpoint (required when AI_MODE=live) ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_FAST=                 # optional, used for triage

# --- System email via our own Resend account (required when RESEND_MODE=live) ---
SYSTEM_RESEND_API_KEY=
SYSTEM_FROM_EMAIL=

# --- Social sign-in (optional; each provider needs both values, buttons appear only when set) ---
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and /api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (only active when BILLING_ENABLED=true) ---
BILLING_ENABLED=false          # false during beta: limits enforced, no payment
STRIPE_MODE=                   # live | fake. Default: live in production or when STRIPE_SECRET_KEY is set, else fake
                               # (fake = in-memory Stripe with a fake hosted checkout/portal under /dev/stripe)
STRIPE_SANDBOX=true            # live mode: true = test keys (sk_test_/rk_test_/pk_test_), false = live keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=        # optional
STRIPE_WEBHOOK_SECRET=         # endpoint <APP_URL>/api/auth/stripe/webhook (Better Auth Stripe plugin: subscriptions)
STRIPE_BILLING_WEBHOOK_SECRET= # endpoint <APP_URL>/api/billing/stripe-webhook (credit packs, invoices)
# Price ids, one variable per price (live mode; checked against Stripe at build time, see docs/PRICING.md):
# STRIPE_PRICE_PRO_MONTHLY=  STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_TEAM_MONTHLY= STRIPE_PRICE_TEAM_ANNUAL=
# STRIPE_PRICE_AGENCY_MONTHLY= STRIPE_PRICE_AGENCY_ANNUAL=
# STRIPE_PRICE_EXTRA_CONNECTION_MONTHLY= STRIPE_PRICE_EXTRA_CONNECTION_ANNUAL=   # Agency, per extra connection
# STRIPE_PRICE_OVERAGE_PRO= STRIPE_PRICE_OVERAGE_TEAM= STRIPE_PRICE_OVERAGE_AGENCY=  # metered, per 10k emails
# STRIPE_PRICE_CREDIT_PACK=      # one-time, per 1,000 AI credits

# --- Observability ---
SENTRY_DSN=                    # empty = Sentry off (no-op); server and browser errors, PII scrubbed
SENTRY_RELEASE=                # optional; defaults to VERCEL_GIT_COMMIT_SHA
SENTRY_AUTH_TOKEN=             # optional, build-time only: uploads source maps (with SENTRY_ORG, SENTRY_PROJECT)
SENTRY_ORG=
SENTRY_PROJECT=

# --- Tests ---
# E2E=true enables the test-only /api/e2e/* seed routes (Playwright sets it itself). Refused in production.
# E2E=

# --- Platform admin panel (/admin) ---
# Comma-separated emails promoted to the Better Auth "admin" role when they sign in (verified address).
PLATFORM_ADMIN_EMAILS=
