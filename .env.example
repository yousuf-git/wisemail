# =============================================================================
# Wisemail API (backend / Fastify) — @wisemail/api
# =============================================================================
# Copy to the repo root as `.env.local` for local development:
#   cp .env.example .env.local
#
# The API loads this file on boot (`apps/api/src/load-root-env.ts`).
# Schema: `packages/shared/src/env-schema.ts` (via `apps/api/lib/env.ts`).
#
# Local defaults: fake Resend / R2 / AI / Stripe, Inngest in-process when the
# Inngest CLI is not running. Production requires live modes + real secrets.
#
# Split deploy (recommended):
#   APP_URL          = Vercel SPA     e.g. https://app.example.com
#   BETTER_AUTH_URL  = OCI Fastify    e.g. https://api.example.com
# Local SPA + API: APP_URL=http://localhost:5173  BETTER_AUTH_URL=http://127.0.0.1:4000
#   (SPA leaves VITE_API_URL empty and proxies /api → API; see apps/spa/.env.example)
#
# Docs: docs/deploy/OCI.md · docs/deploy/VERCEL.md · AGENTS.md

# --- Core (always required) ---
MONGODB_URI=mongodb://127.0.0.1:27017/wisemail?replicaSet=rs0
BETTER_AUTH_SECRET=            # >= 32 chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=http://127.0.0.1:4000
APP_URL=http://localhost:5173

# SPA_ORIGINS=                 # comma-separated extra CORS / trusted origins (Vercel previews)
# COOKIE_DOMAIN=.example.com   # share session across app. + api. subdomains (production split)

# Listen address (aliases HOST/PORT also accepted)
# API_HOST=127.0.0.1
# API_PORT=4000

ENCRYPTION_KEK_CURRENT=        # base64-encoded 32 bytes, e.g. `openssl rand -base64 32`
ENCRYPTION_KEK_ID=kek-1
ENCRYPTION_KEK_PREVIOUS=       # optional, during KEK rotation
ENCRYPTION_KEK_PREVIOUS_ID=    # required with ENCRYPTION_KEK_PREVIOUS

# --- Service modes (default: fake in dev/test, live in production) ---
RESEND_MODE=fake               # live | fake
STORAGE_MODE=fake              # r2 | fake
AI_MODE=fake                   # live | fake
INNGEST_DEV=true               # true = local Inngest / inline jobs; false needs keys below

# --- Inngest (required when INNGEST_DEV=false) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cloudflare R2 (required when STORAGE_MODE=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- AI, any OpenAI-compatible endpoint (required when AI_MODE=live) ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_FAST=                 # optional, used for triage

# --- System email via Wisemail's Resend account (required when RESEND_MODE=live) ---
SYSTEM_RESEND_API_KEY=
SYSTEM_FROM_EMAIL=

# --- Social sign-in (optional; each provider needs both id + secret) ---
# Callbacks: <BETTER_AUTH_URL>/api/auth/callback/google and …/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (only active when BILLING_ENABLED=true) ---
BILLING_ENABLED=false          # false during beta: limits enforced, no payment
STRIPE_MODE=                   # live | fake. Default: live in production or when STRIPE_SECRET_KEY is set, else fake
STRIPE_SANDBOX=true            # live mode: true = test keys (sk_test_/pk_test_), false = live keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=        # optional (Checkout UI / Elements if used)
# Webhooks hit the API host (BETTER_AUTH_URL), not the SPA:
STRIPE_WEBHOOK_SECRET=         # <BETTER_AUTH_URL>/api/auth/stripe/webhook (subscriptions)
STRIPE_BILLING_WEBHOOK_SECRET= # <BETTER_AUTH_URL>/api/billing/stripe-webhook (packs, invoices)
# Price ids (live billing; see docs/PRICING.md). Fake mode uses price_fake_<key>.
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_TEAM_ANNUAL=
# STRIPE_PRICE_AGENCY_MONTHLY=
# STRIPE_PRICE_AGENCY_ANNUAL=
# STRIPE_PRICE_EXTRA_CONNECTION_MONTHLY=
# STRIPE_PRICE_EXTRA_CONNECTION_ANNUAL=
# STRIPE_PRICE_OVERAGE_PRO=
# STRIPE_PRICE_OVERAGE_TEAM=
# STRIPE_PRICE_OVERAGE_AGENCY=
# STRIPE_PRICE_CREDIT_PACK=

# --- Observability ---
SENTRY_DSN=                    # empty = Sentry off
SENTRY_RELEASE=                # optional
SENTRY_AUTH_TOKEN=             # optional, build-time source maps (with SENTRY_ORG / SENTRY_PROJECT)
SENTRY_ORG=
SENTRY_PROJECT=

# --- Tests ---
# E2E=true enables /api/e2e/* seed routes (Playwright). Refused in production.
# E2E=

# --- Platform admin (/admin) ---
# Comma-separated emails promoted to Better Auth role "admin" on verified sign-in.
PLATFORM_ADMIN_EMAILS=
