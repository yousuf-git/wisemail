{
  "name": "@wisemail/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plans": {
      "types": "./dist/plans.d.ts",
      "default": "./dist/plans.js"
    },
    "./stripe-prices": {
      "types": "./dist/stripe-prices.d.ts",
      "default": "./dist/stripe-prices.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./billing-dto": {
      "types": "./dist/billing-dto.d.ts",
      "default": "./dist/billing-dto.js"
    },
    "./env-schema": {
      "types": "./dist/env-schema.d.ts",
      "default": "./dist/env-schema.js"
    },
    "./action-result": {
      "types": "./dist/action-result.d.ts",
      "default": "./dist/action-result.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
